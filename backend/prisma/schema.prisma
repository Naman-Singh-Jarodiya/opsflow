generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  MEMBER
}

enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  RESOLVED
  CLOSED
}

enum WorkItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  CREATED
  UPDATED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  COMMENT_ADDED
  TEAM_CHANGED
  DELETED
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  passwordHash    String
  role            UserRole         @default(MEMBER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  memberships     TeamMembership[]
  createdWork     WorkItem[]       @relation("CreatedWorkItems")
  assignedWork    WorkItem[]       @relation("AssignedWorkItems")
  comments        Comment[]
  activities      Activity[]       @relation("UserActivities")
  assignedItems   WorkItem[]       @relation("AssignedByUser")
}

model Team {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  memberships     TeamMembership[]
  workItems       WorkItem[]
}

model TeamMembership {
  id              String   @id @default(cuid())
  userId          String
  teamId          String
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

model WorkItem {
  id              String           @id @default(cuid())
  title           String
  description     String?
  status          WorkItemStatus   @default(OPEN)
  priority        WorkItemPriority @default(MEDIUM)

  teamId          String
  assigneeId      String?
  createdById     String
  assignedById    String?

  dueDate         DateTime?
  version         Int              @default(1)

  deletedAt       DateTime?
  deletedById     String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  team            Team             @relation(fields: [teamId], references: [id])
  assignee        User?            @relation("AssignedWorkItems", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy       User             @relation("CreatedWorkItems", fields: [createdById], references: [id])
  assignedBy      User?            @relation("AssignedByUser", fields: [assignedById], references: [id], onDelete: SetNull)

  comments        Comment[]
  activities      Activity[]

  @@index([teamId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([teamId, status])
  @@index([teamId, priority])
}

model Comment {
  id              String    @id @default(cuid())
  content         String
  workItemId      String
  authorId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workItem        WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author          User      @relation(fields: [authorId], references: [id])

  @@index([workItemId, createdAt])
}

model Activity {
  id              String       @id @default(cuid())
  type            ActivityType
  message         String
  workItemId      String
  userId          String
  metadata        Json?
  createdAt       DateTime     @default(now())

  workItem        WorkItem      @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user            User          @relation("UserActivities", fields: [userId], references: [id])

  @@index([workItemId, createdAt])
  @@index([userId, createdAt])
}

model IdempotencyKey {
  id              String   @id @default(cuid())
  key             String
  userId          String
  requestHash     String
  responseStatus  Int?
  responseBody    Json?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([key, userId])
  @@index([expiresAt])
}